{
  "format": "NodeForgeGraph",
  "version": 2,
  "requestId": "GraphDeliveryWrite",
  "assetType": "Blueprint",
  "assetPath": "/Game/NodeForgeTests/NFGraphDeliveryWrite",
  "catalogDigest": "CATALOG_DIGEST_FROM_REAL_ENGINE",
  "nodes": [
    {
      "id": "Begin",
      "class": "/Script/BlueprintGraph.K2Node_Event",
      "properties": {
        "owner": "/Script/Engine.Actor",
        "member": "ReceiveBeginPlay"
      }
    },
    {
      "id": "Move",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.Actor",
        "member": "K2_SetActorLocation"
      },
      "defaults": {
        "bSweep": false,
        "bTeleport": true
      }
    },
    {
      "id": "Print",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.KismetSystemLibrary",
        "member": "PrintString"
      },
      "defaults": {
        "bPrintToScreen": false,
        "bPrintToLog": true
      }
    },
    {
      "id": "Read",
      "class": "/Script/BlueprintGraph.K2Node_VariableGet",
      "properties": {
        "variable": "TargetPosition"
      }
    },
    {
      "id": "Write",
      "class": "/Script/BlueprintGraph.K2Node_VariableSet",
      "properties": {
        "variable": "TargetPosition"
      },
      "defaults": {
        "TargetPosition": [
          -15,
          0,
          45
        ]
      }
    },
    {
      "id": "ReadLocation",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.Actor",
        "member": "K2_GetActorLocation"
      }
    },
    {
      "id": "Text",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.KismetStringLibrary",
        "member": "Conv_VectorToString"
      }
    }
  ],
  "edges": [
    {
      "from": "Begin",
      "output": "then",
      "to": "Write",
      "input": "execute"
    },
    {
      "from": "Write",
      "output": "then",
      "to": "Move",
      "input": "execute"
    },
    {
      "from": "Move",
      "output": "then",
      "to": "Print",
      "input": "execute"
    },
    {
      "from": "Read",
      "output": "TargetPosition",
      "to": "Move",
      "input": "NewLocation"
    },
    {
      "from": "ReadLocation",
      "output": "ReturnValue",
      "to": "Text",
      "input": "InVec"
    },
    {
      "from": "Text",
      "output": "ReturnValue",
      "to": "Print",
      "input": "InString"
    }
  ],
  "settings": {
    "parentClass": "/Script/Engine.Actor",
    "variables": [
      {
        "name": "TargetPosition",
        "type": "vector",
        "default": [
          0,
          0,
          0
        ]
      }
    ]
  }
}
