{
  "format": "NodeForgeGraph",
  "version": 2,
  "requestId": "GraphMotionShuffled",
  "assetType": "Blueprint",
  "assetPath": "/Game/NodeForgeTests/NFGraphMotionShuffled",
  "catalogDigest": "CATALOG_DIGEST_FROM_REAL_ENGINE",
  "nodes": [
    {
      "id": "Make",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.KismetMathLibrary",
        "member": "MakeVector"
      },
      "defaults": {
        "X": 10,
        "Y": 20,
        "Z": 30
      }
    },
    {
      "id": "Print",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.KismetSystemLibrary",
        "member": "PrintString"
      },
      "defaults": {
        "InString": "Actor moved from JSON",
        "bPrintToScreen": false,
        "bPrintToLog": true
      }
    },
    {
      "id": "Move",
      "class": "/Script/BlueprintGraph.K2Node_CallFunction",
      "properties": {
        "owner": "/Script/Engine.Actor",
        "member": "K2_SetActorLocation"
      },
      "defaults": {
        "bSweep": false,
        "bTeleport": true
      }
    },
    {
      "id": "Begin",
      "class": "/Script/BlueprintGraph.K2Node_Event",
      "properties": {
        "owner": "/Script/Engine.Actor",
        "member": "ReceiveBeginPlay"
      }
    }
  ],
  "edges": [
    {
      "from": "Make",
      "output": "ReturnValue",
      "to": "Move",
      "input": "NewLocation"
    },
    {
      "from": "Move",
      "output": "then",
      "to": "Print",
      "input": "execute"
    },
    {
      "from": "Begin",
      "output": "then",
      "to": "Move",
      "input": "execute"
    }
  ],
  "settings": {
    "parentClass": "/Script/Engine.Actor",
    "variables": []
  }
}
